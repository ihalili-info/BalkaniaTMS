# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sent (sent.dm) — unified SMS / WhatsApp / RCS API
# POST https://api.sent.dm/v3/messages
#
# SENT_DM_API_KEY is sent as the `x-api-key` header (confirmed in the docs).
SENT_DM_API_KEY=
#
# Sender Profile, sent as `x-profile-id`. Sent's authentication reference says
# the API key alone identifies the caller and "no other identifier is
# required", so this is probably unnecessary — leave it blank unless your
# account turns out to need it. Sent only when set.
SENT_PROFILE_ID=
#
# Signing secret for inbound delivery-status webhooks, copied from the Sent
# dashboard WITH its `whsec_` prefix. Verified: HMAC-SHA256 over
# "{X-Webhook-ID}.{X-Webhook-Timestamp}.{rawBody}", compared against the
# `v1,{base64}` X-Webhook-Signature header, five-minute replay window.
SENT_WEBHOOK_SECRET=

# Geocoding (address -> lat/lng, used by Auto-plan and CRM order ingestion)
#
# Google Geocoding API. SERVER-SIDE ONLY — this key is never sent to a browser,
# so it must have NO HTTP referrer restriction (a server call sends no
# referrer); restrict it by API instead. Keep it separate from the basemap key
# below, which is public by necessity.
GEOCODING_API_KEY=

# Routing & ETA (road distance / drive time)
#
# Google Routes API — powers auto-plan sequencing on real roads and the live
# truck→next-stop ETA on Active Loads. SERVER-SIDE ONLY, same rules as
# GEOCODING_API_KEY: no HTTP referrer restriction, restrict by API (enable the
# "Routes API"). May be the SAME key value as GEOCODING_API_KEY if that Google
# Cloud project has the Routes API enabled; the code falls back to
# GEOCODING_API_KEY when this is unset. Unset -> every distance is great-circle
# at a flat 45 km/h, and the UI says so.
#
# NB: Google Routes is CAR routing. It does not know HGV height/weight/ADR
# limits — truckRoutingWarning() still applies at every navigation handoff.
ROUTING_API_KEY=

# Vehicle GPS / Telematics — see the Verizon Connect block below.
# GPS_WEBHOOK_SECRET is the Basic-auth password for the inbound GPS webhook.
GPS_WEBHOOK_SECRET=

# CRM webhook auth
CRM_WEBHOOK_SECRET=

# Tachograph / driver hours (Reg. (EU) 165/2014)
# Separate from the GPS feed — position is not duty, and only the tachograph
# record is legal evidence of driving time.
TACHOGRAPH_API_KEY=
TACHOGRAPH_WEBHOOK_SECRET=

# Customs — GB movements and Windsor Framework lanes for Northern Ireland
CUSTOMS_API_KEY=
EORI_NUMBER=
UKIMS_AUTHORISATION=

# --- Verizon Connect Reveal (Fleetmatics) --------------------------------
# The fleet's GPS provider. Portal: https://fim.eu.fleetmatics.com
#
# Pull (RAD REST API). FLEETMATICS_ENV is the environment segment in
# fim.api.<env>.fleetmatics.com — `eu` for this account.
#
# USERNAME/PASSWORD are the Reveal **Integration User** issued by Verizon by
# email, NOT the developer-portal login. They look like
# REST_<Name>_<n>@<accountId>.com. Using the portal login here fails the token
# call with 400 Invalid Login.
#
# APP_ID comes from the developer portal (profile icon -> My Apps) and looks
# like `fleetmatics-p-eu-XXXXXXXX` — not a UUID.
FLEETMATICS_ENV=eu
FLEETMATICS_APP_ID=
FLEETMATICS_USERNAME=
FLEETMATICS_PASSWORD=

# Push (GPS webhook) — Basic auth credentials WE choose and enter in the Reveal
# "Submit GPS webhook endpoints" form (reveal.eu.vzconnect.com -> admin ->
# integration -> partner integrations -> webhook), alongside the endpoint URL
# https://tms.balkania.ie/api/webhooks/gps. Not issued by Verizon.
#
# Endpoint constraints from Verizon's guide:
#   - hostname must have NO underscore (tms.balkania.ie is fine)
#   - username / password must AVOID  / \ ' " : @  and other escape chars.
#     Stick to letters, digits, and - or _.
# The feed runs on AWS SNS: the first SubscriptionConfirmation arrives with no
# credentials and our endpoint answers 401 + WWW-Authenticate, then SNS retries
# with the values below. The SubscribeURL token expires after 3 DAYS — if the
# handshake does not complete, resubmit the endpoint in Reveal for a fresh one.
GPS_WEBHOOK_USER=

# --- Geotab (MyGeotab) ----------------------------------------------------
# NOT WIRED UP — placeholder for a possible second GPS provider. No route or
# client exists yet; see the Geotab card on Integration Settings.
#
# MyGeotab has no API-key concept: it authenticates as a MyGeotab user
# (database + username + password) via a JSON-RPC "Authenticate" call and
# returns a session id, not a bearer token. Per Geotab's own service-account
# guidance, USERNAME/PASSWORD should be a dedicated, non-personal login scoped
# to the lowest security clearance the integration needs (View Only is
# usually enough for reading positions) — not a dispatcher's own account.
# https://support.geotab.com/help/mygeotab/access-and-administration/database-administration/service-accounts
#
# SERVER starts as my.geotab.com; the Authenticate response's `path` names the
# actual server that DATABASE lives on, which then replaces this value —
# Geotab databases are not all on the same host.
GEOTAB_SERVER=my.geotab.com
GEOTAB_DATABASE=
GEOTAB_USERNAME=
GEOTAB_PASSWORD=

# --- Google Maps basemap (Live Fleet Map) --------------------------------
# NEXT_PUBLIC_, therefore visible in page source — the Maps JavaScript API
# authenticates in the browser and cannot be proxied. Restrict it in Google
# Cloud Console to the *Maps JavaScript API* and to HTTP referrers
# (tms.balkania.ie/*, localhost:*), and keep it as a SEPARATE key from
# GEOCODING_API_KEY above, which stays server-only. Unset -> the map falls back
# to the schematic projection.
# GOOGLE_MAPS_API_KEY is accepted too and is read per request, so a change in
# Vercel takes effect on save instead of needing a redeploy. It is NOT more
# private for being unprefixed — the key reaches the browser either way.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
