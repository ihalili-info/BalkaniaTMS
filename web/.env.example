# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (SMS / WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Geocoding (address -> lat/lng on CRM order ingestion)
GEOCODING_API_KEY=

# Vehicle GPS / Telematics provider
GPS_PROVIDER_API_KEY=
GPS_WEBHOOK_SECRET=

# CRM webhook auth
CRM_WEBHOOK_SECRET=

# Tachograph / driver hours (Reg. (EU) 165/2014)
# Separate from the GPS feed — position is not duty, and only the tachograph
# record is legal evidence of driving time.
TACHOGRAPH_API_KEY=
TACHOGRAPH_WEBHOOK_SECRET=

# Customs — GB movements and Windsor Framework lanes for Northern Ireland
CUSTOMS_API_KEY=
EORI_NUMBER=
UKIMS_AUTHORISATION=
